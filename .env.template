# ─────────────────────────────────────────────────────────────────────────────
# .env.template — copy this file to .env and fill in your values.
# .env is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Microsoft Foundry ───────────────────────────────────────────────────────

# Your Foundry project endpoint.
# Find it in the Azure portal: AI Foundry → your project → Overview → Endpoint
# Format: https://<account>.cognitiveservices.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.cognitiveservices.azure.com/api/projects/<project>

# The name of your gpt-4o (or other) model deployment in Foundry.
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o

# ── Agent settings ───────────────────────────────────────────────────────────

# Must match the name used in register_agent.py and agent.py.
AGENT_NAME=outcome-readiness-agent

# The maximum expected hours saved per SoW review (used to normalise the
# continuous eval score to 0–1). 8.0 = one analyst workday.
MAX_HOURS_SAVED=8.0

# ── Observability (required for continuous evaluation) ───────────────────────

# Application Insights connection string — REQUIRED for the
# ContinuousEvaluationRule to fire. Without this, eval runs will not appear
# in the Foundry portal.
#
# Retrieve it by running this command (after filling in FOUNDRY_PROJECT_ENDPOINT above):
#
#   python -c "
#   from azure.ai.projects import AIProjectClient
#   from azure.identity import DefaultAzureCredential
#   import os; from dotenv import load_dotenv; load_dotenv()
#   client = AIProjectClient(endpoint=os.getenv('FOUNDRY_PROJECT_ENDPOINT'), credential=DefaultAzureCredential())
#   print(client.telemetry.get_application_insights_connection_string())
#   "
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<region>.livediagnostics.monitor.azure.com/;ApplicationId=<id>
